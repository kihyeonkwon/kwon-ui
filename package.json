{
  "name": "kwon-ui",
  "version": "0.1.0",
  "description": "권앤컴퍼니의 세 제품(홈페이지, 스킬캠퍼스, Projects)이 같이 쓰는 디자인 시스템: 토큰, 글자, 뼈대, 컴포넌트, 검사기",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./kwon-ui.css": "./dist/kwon-ui.css",
    "./classes.json": "./dist/classes.json",
    "./check": "./check/index.mjs",
    "./CATALOG.md": "./CATALOG.md",
    "./package.json": "./package.json"
  },
  "bin": {
    "kwon-ui": "./bin/kwon-ui.mjs"
  },
  "files": [
    "dist",
    "!dist/catalog",
    "check",
    "bin",
    "claude",
    "CATALOG.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run build && npm test",
    "prepublishOnly": "npm run verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "postcss": "^8.4.47"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "pretendard": "^1.3.9",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
